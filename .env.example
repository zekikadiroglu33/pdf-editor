# Copy this file to .env and set your real domain (must already have a
# DNS A/AAAA record pointing at this server - Caddy needs that to issue a
# Let's Encrypt certificate automatically).
DOMAIN=pdfer.example.com

# Google Analytics 4 measurement ID (Admin > Data Streams in GA). Leave
# unset to disable analytics - the tracking snippet is simply omitted.
GA_MEASUREMENT_ID=G-XXXXXXXXXX
